# Stage 1: Build Maven Service
FROM maven:3.9-eclipse-temurin-17-alpine AS builder
WORKDIR /build
COPY backend/pom.xml .
COPY backend/common/pom.xml ./common/
COPY backend/auth-service/pom.xml ./auth-service/
COPY backend/employee-service/pom.xml ./employee-service/
COPY backend/attendance-service/pom.xml ./attendance-service/
COPY backend/leave-service/pom.xml ./leave-service/
COPY backend/payroll-service/pom.xml ./payroll-service/
COPY backend/performance-service/pom.xml ./performance-service/
COPY backend/notification-service/pom.xml ./notification-service/
COPY backend/ai-service/pom.xml ./ai-service/
COPY backend/api-gateway/pom.xml ./api-gateway/

COPY backend/ .
RUN mvn clean package -DskipTests

# Stage 2: Runtime Image with Non-Root User
FROM eclipse-temurin:17-jre-alpine
RUN addgroup -S nexushr && adduser -S nexushr -G nexushr
WORKDIR /app

ARG SERVICE_NAME
COPY --from=builder /build/${SERVICE_NAME}/target/*.jar app.jar

RUN chown -R nexushr:nexushr /app
USER nexushr

EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
