# NexusHR Environment Configuration Example

# Application Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Database Configuration (PostgreSQL 17)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/nexushr
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

# Redis Cache Configuration
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security / JWT
JWT_SECRET=your_super_secret_jwt_key_here_min_256_bits_length
JWT_EXPIRATION=86400000

# AI Service (Spring AI + Gemini)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App URL
APP_URL="MY_APP_URL"
VITE_API_BASE_URL=http://localhost:8080
