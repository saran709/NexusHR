{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowS3DocumentAccess",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::nexushr-employee-documents-production",
        "arn:aws:s3:::nexushr-employee-documents-production/*"
      ]
    },
    {
      "Sid": "AllowSecretsManagerAccess",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:us-east-1:123456789012:secret:nexushr/production/*"
      ]
    }
  ]
}
